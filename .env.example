# =====================================================================
# EVR-KIDS - Configuración de claves y opciones
# Copia este archivo como ".env" y rellena SOLO lo que vayas a usar.
# Todo es opcional: sin claves la app funciona en modo offline
# (ilustraciones procedurales + música procedural + edge-tts).
# =====================================================================

# ---------- Carpetas ----------
EVR_DIR_SALIDA=salida
EVR_DIR_TRABAJO=trabajo
EVR_DIR_CACHE=cache

# ---------- Guiones con IA (opcional, Claude de Anthropic) ----------
# Se usa solo para temas personalizados (genera el vocabulario).
ANTHROPIC_API_KEY=
EVR_MODELO_CLAUDE=claude-opus-5

# ---------- Imágenes de stock (uso comercial permitido) ----------
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Wikimedia Commons no necesita clave (se filtra solo CC0 / dominio público)

# ---------- Imágenes con IA ----------
# Local con diffusers (requiere torch + GPU recomendada)
EVR_DIFFUSERS_MODELO=stabilityai/stable-diffusion-xl-base-1.0
EVR_DIFFUSERS_DISPOSITIVO=auto          # auto | cuda | mps | cpu
# Automatic1111 (lanzar con --api)
A1111_URL=http://127.0.0.1:7860
# ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# Nube
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODELO=black-forest-labs/flux-schnell
HF_API_TOKEN=
HF_MODELO=stabilityai/stable-diffusion-xl-base-1.0

# ---------- Voces (edge-tts no necesita clave) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_MODELO=eleven_multilingual_v2
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Amazon Polly usa las credenciales estándar de AWS (boto3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---------- Música / efectos ----------
FREESOUND_API_KEY=

# ---------- Video ----------
EVR_RESOLUCION=1080p                    # 1080p | 720p (videos largos)
EVR_PRESET_X264=medium                  # ultrafast ... slow
